<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="10dp" android:background="@drawable/widget_bg">

    <ImageView android:id="@+id/w_art" android:layout_width="60dp" android:layout_height="60dp"
        android:scaleType="centerCrop" android:contentDescription="Cover" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginStart="12dp" android:layout_marginEnd="4dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <ImageButton android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp"
        android:background="@null" android:src="@drawable/ic_w_prev" android:contentDescription="Previous" />
    <ImageButton android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp"
        android:background="@null" android:src="@drawable/ic_w_play" android:contentDescription="Play or pause" />
    <ImageButton android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp"
        android:background="@null" android:src="@drawable/ic_w_next" android:contentDescription="Next" />
</LinearLayout>
